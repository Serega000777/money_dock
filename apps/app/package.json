{
  "name": "@money-dock/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "dotenv -e ../../.env -- expo start",
    "web": "dotenv -e ../../.env -- expo start --web",
    "build": "dotenv -e ../../.env -- expo export --platform web --clear",
    "native:prebuild": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@money-dock/api-client": "workspace:*",
    "@money-dock/design-tokens": "workspace:*",
    "@money-dock/shared-types": "workspace:*",
    "@money-dock/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "^57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "^57.0.11",
    "expo-router": "^57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "^57.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@money-dock/config": "workspace:*",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "^57.0.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "typescript": "^6.0.3"
  }
}
