{
  "name": "@money-dock/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "dotenv -e ../../.env -- expo start",
    "web": "dotenv -e ../../.env -- expo start --web",
    "build": "dotenv -e ../../.env -- expo export --platform web --clear",
    "native:prebuild": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:android": "eas build --platform android --profile production",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.15",
    "@money-dock/api-client": "workspace:*",
    "@money-dock/design-tokens": "workspace:*",
    "@money-dock/shared-types": "workspace:*",
    "@money-dock/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "^58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "^58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "^58.0.14",
    "expo-router": "^58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "^58.0.11",
    "expo-status-bar": "^58.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@money-dock/config": "workspace:*",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^58.0.20",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.17.0",
    "typescript": "^6.0.3"
  }
}
