{
  "expo": {
    "name": "Amola Finance",
    "slug": "amola-finance",
    "scheme": "amola",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-status-bar", "expo-splash-screen", "expo-font"],
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.amola.finance"
    },
    "android": {
      "package": "app.amola.finance"
    }
  }
}
