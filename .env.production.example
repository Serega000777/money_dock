# Production values for infrastructure/docker/docker-compose.prod.yml.
# Copy to .env.production on the server and fill in every line. Never commit it.

# The public domain the Mini App lives on — its A record must already point at the VPS.
DOMAIN=amola-finance.ru

# Postgres password for the private database container (any long random string).
POSTGRES_PASSWORD=

# From @BotFather (/newbot). The API verifies every Mini App launch against it.
TELEGRAM_BOT_TOKEN=

# Signs access JWTs. 32+ chars; generate with:
#   openssl rand -hex 48
JWT_ACCESS_SECRET=

# Comma-separated Telegram numeric user ids (from @userinfobot) promoted to the `admin`
# role on their next login — grants /admin/* API access.
ADMIN_TELEGRAM_IDS=

# A single Telegram numeric user id whose cabinet shows the "Админ-панель" link. Kept
# separate from ADMIN_TELEGRAM_IDS so adding support staff there later doesn't also hand
# them the owner dashboard link. Leave empty and the link never shows, for anyone.
OWNER_TELEGRAM_ID=

# Verifies the X-Telegram-Bot-Api-Secret-Token header on incoming webhook calls. Required
# for the bot's /start flow to work at all. Generate with:
#   openssl rand -hex 24
# After deploying, register it with Telegram (from apps/api, with this same env):
#   TELEGRAM_BOT_TOKEN=... TELEGRAM_WEBHOOK_SECRET=... PUBLIC_URL=https://DOMAIN \
#     pnpm telegram:set-webhook
TELEGRAM_WEBHOOK_SECRET=

# Optional public HTTPS image URL sent with the bot's /start welcome message. The web
# container serves apps/app/public/telegram-banner.png at exactly this path, so this is
# the real value to use, not a placeholder — swap it only if you replace that file.
TELEGRAM_BANNER_URL=https://amola-finance.ru/telegram-banner.png

# Optional t.me links for the account screen's "Служба поддержки" / "Предложить
# изменение" rows. Baked into the web bundle at build time, like EXPO_PUBLIC_API_URL —
# leave empty and those rows just show "Скоро" until you have real support chats.
SUPPORT_TELEGRAM_URL=
FEEDBACK_TELEGRAM_URL=

# Google AI Studio key (aistudio.google.com/apikey) used to transcribe voice input on
# iOS, which has no browser SpeechRecognition API. Leave empty and the /commands/transcribe
# endpoint returns 503 — voice capture keeps working on Android, just not on iPhone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# One Yandex Cloud service account with roles `ai.speechkit-stt.user` and
# `ai.models.user`, one API key from it. That same key + folder ID also goes into
# DEEPSEEK_API_KEY below.
SPEECH_PROVIDER=yandex
YANDEX_SPEECHKIT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SPEECHKIT_MODEL=general

ASSISTANT_ENABLED=true
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=gigachat
# Primary: DeepSeek V4 Flash hosted on Yandex AI Studio (same key/folder as SpeechKit
# above). Model id is a `gpt://` URI regardless of the underlying model — that's just
# Yandex's scheme name, not a typo.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=gpt://<YANDEX_FOLDER_ID>/deepseek-v4-flash
DEEPSEEK_BASE_URL=https://ai.api.cloud.yandex.net/v1
DEEPSEEK_AUTH_SCHEME=api-key
# Fallback only, called after a retryable DeepSeek failure. Authorization key from
# developers.sber.ru/portal/products/gigachat-api. TLS trust for its Minzifry-issued
# chain ships bundled at apps/api/certs/russian-trusted-ca.pem — nothing to add here.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
