# Copy to .env and fill in real values. Never commit the real .env file.

# Defaults to `production` when unset, so a deployment that forgets this flag keeps
# /auth/dev-login (a session with no credentials) switched off. Set it explicitly here
# for local work.
NODE_ENV=development
PORT=3000

# Postgres connection string used by the API and by drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/money_dock

# Required — there is no default. One origin or a comma-separated list, e.g.
#   CORS_ORIGIN=https://app.example.com,https://web.telegram.org
# `*` is rejected when NODE_ENV=production: it would let any site on the internet read
# API responses using a stolen token.
CORS_ORIGIN=*

# From @BotFather. Required to verify Telegram Mini App initData server-side.
TELEGRAM_BOT_TOKEN=

# Random 32+ char secret used to sign access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Consumed by apps/app to reach the API. In Telegram, this must be a public HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Comma-separated Telegram numeric user ids (from @userinfobot or similar) promoted to
# the `admin` role on their next login. Empty = no admin panel access for anyone.
ADMIN_TELEGRAM_IDS=

# Verifies the X-Telegram-Bot-Api-Secret-Token header on incoming webhook calls (set via
# telegram:set-webhook). Optional locally — the bot's /start flow just won't run without
# a registered webhook anyway. 16+ chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Optional public HTTPS image URL sent with the bot's /start welcome message.
TELEGRAM_BANNER_URL=

# Optional t.me links for the account screen's "Служба поддержки" / "Предложить
# изменение" rows. Empty = those rows show "Скоро" until you have real support chats.
EXPO_PUBLIC_SUPPORT_TELEGRAM_URL=
EXPO_PUBLIC_FEEDBACK_TELEGRAM_URL=

# Google AI Studio key (aistudio.google.com/apikey) used to transcribe voice input on
# iOS, which has no browser SpeechRecognition API. Leave empty and /commands/transcribe
# returns 503 — voice capture keeps working on Android, just not on iPhone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Active production speech-to-text pipeline. Create a scoped service-account API key
# with yc.ai.speechkitStt.execute; secrets belong on the API server only.
SPEECH_PROVIDER=yandex
YANDEX_SPEECHKIT_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_SPEECHKIT_MODEL=general

ASSISTANT_ENABLED=true
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=gigachat
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
