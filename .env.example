# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# Postgres connection string used by the API and by drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/money_dock

# Comma-separated list of allowed origins, or * for all (dev only).
CORS_ORIGIN=*

# From @BotFather. Required to verify Telegram Mini App initData server-side.
TELEGRAM_BOT_TOKEN=

# Random 32+ char secrets used to sign access/refresh JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Consumed by apps/app to reach the API. In Telegram, this must be a public HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
