# Copy to .env and fill in real values. Never commit the real .env file.

# Defaults to `production` when unset, so a deployment that forgets this flag keeps
# /auth/dev-login (a session with no credentials) switched off. Set it explicitly here
# for local work.
NODE_ENV=development
PORT=3000

# Postgres connection string used by the API and by drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/money_dock

# Required — there is no default. One origin or a comma-separated list, e.g.
#   CORS_ORIGIN=https://app.example.com,https://web.telegram.org
# `*` is rejected when NODE_ENV=production: it would let any site on the internet read
# API responses using a stolen token.
CORS_ORIGIN=*

# From @BotFather. Required to verify Telegram Mini App initData server-side.
TELEGRAM_BOT_TOKEN=

# Random 32+ char secret used to sign access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# Consumed by apps/app to reach the API. In Telegram, this must be a public HTTPS URL.
EXPO_PUBLIC_API_URL=http://localhost:3000
